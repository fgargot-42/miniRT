A 0.2 255,255,255
C 0,10,-30 0,0,1 70
L -10,20,-10 1.0 255,255,255

# Floor: big red/white checker squares (scale 4 = large tiles)
pl 0,0,0 0,1,0 255,0,0 255,255,255 10.0 0.2 32 

# Left sphere: fine blue/yellow checker (scale 0.3 = tiny squares)
sp -8,4,0 8 0,0,255 255,255,0 0.3 0.3 32

# Right sphere: default scale (1.0, omitted) green/black checker
sp 8,4,0 8 0,255,0 0,0,0 . 0.2 32
