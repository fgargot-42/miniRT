# This is an example .rt file showing how to set up a miniRT scene

# Ambient (Unique)
# A intensity	color(r,g,b)
A 0.15	255,255,255

# Camera (Unique)
# C	pos(x,y,z)		dir(x,y,z normalized)	fov
C	0.0,5.0,20.0	0.0,0.0,-1.0			70

# Light (multi-light supported with bonus)
# L	pos(x,y,z)		intensity	color(r,g,b)
L	20.0,12.0,15.0		0.75		255,255,255

# Sky (Unique)
# S color(r,g,b)
S	180,140,255

# Skybox (Unique)
# SB file_path
SB	../textures/sky_4k.jpg

# For the following objects (except `obj`), the following optional paramters may be added.
# They must be specified in the same line, after the mandatory parameters.
# They will be interpreted in order, and you can leave any parameter blank by adding a single `.`

# [checkered_color	specular	shininess	opacity refraction	textures(diff,spec,bump,opacity)]

# Sphere
# sp	pos(x,y,z)		diameter	color(r,g,b)
sp		2.0,0.0,6.0		3.0			230,230,230		230,230,230			0.6			32			1		../textures/8k_earth_daymap.jpg . ../textures/8k_earth_bump.jpg

# Cylinder
# cy	pos(x,y,z)		dir(x,y,z)		diameter	height	color(r,g,b)
cy		-2.0,1.0,8.0	0.0,1.0,0.0		4			4		0,153,0			. 0.6			16

# Plane
# pl	pos(x,y,z)	normal(x,y,z)	color(r,g,b)
pl		2.0,-1.5,0	0.0,1.0,0.0		200,200,200			30,30,30		0.4			8

# Cone
# co	pos(x,y,z)		dir(x,y,z)		angle(deg)	height	depth	color(r,g,b)
co		2.0,3.0,1.0		0.0,1.0,0.0		60			0		1		255,215,0 		.	0.4			8

# Hyperboloid
# hy	pos(x,y,z)		dir(x,y,z)		radius	angle(deg)	height	depth	color(r,g,b)
hy		2.0,5.0,2.0		0.0,1.0,0.0		.5 		45			2		2		64,192,192	.	0.6			32

# Paraboloid
# pa	pos(x,y,z)		dir(x,y,z)		angle(deg)	height	color(r,g,b)
pa		-2.0,2.0,2.0	0.0,1.0,0.0		60			3		64,208,176		.	0.6			32

# Object
# obj	pos(x,y,z)		filepath(*.obj)
obj		0.0,2.0,10.0	forty_two/fortytwo.obj
